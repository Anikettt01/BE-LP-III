      "source": [
        "def f(x):\n",
        "  return (x+3)**2;\n",
        "\n",
        "def df(x):\n",
        "  return 2*(x+3)\n",
        "\n",
        "x=2\n",
        "learning_rate=0.1\n",
        "\n",
        "for i in range(30):\n",
        "  x=x-learning_rate*df(x);\n",
        "  print(\"steps\",i+1,\": x =\",x,\" f(x) =\",f(x))\n",
        "\n",
        "print(\"\\nLocal minimum is approximately at x= \",x)"
      ]
